{
  "version": "1.0",
  "title": "每日基金研究驾驶舱",
  "blocks": [
    {
      "id": "daily-research-metrics",
      "type": "metrics",
      "title": "研究与数据状态",
      "items": [
        { "label": "研究范围", "valuePath": "dailyCockpit.metrics.totalFunds", "format": "number" },
        { "label": "证据覆盖", "valuePath": "dailyCockpit.metrics.evidenceCoverage", "format": "percent" },
        { "label": "研究清单", "valuePath": "dailyCockpit.metrics.candidateCount", "format": "number" },
        { "label": "被门槛阻断", "valuePath": "dailyCockpit.metrics.blockedCandidateCount", "format": "number" },
        { "label": "未决复核", "valuePath": "dailyCockpit.metrics.unresolvedAlertCount", "format": "number" }
      ]
    },
    {
      "id": "daily-research-queue",
      "type": "table",
      "title": "今日研究队列",
      "rowsPath": "dailyCockpit.tasks",
      "columns": [
        { "key": "title", "label": "任务", "format": "text" },
        { "key": "detail", "label": "原因", "format": "text" },
        { "key": "tone", "label": "状态", "format": "text" },
        { "key": "source", "label": "来源", "format": "text" }
      ],
      "emptyText": "当前没有返回研究待办"
    },
    {
      "id": "evidence-source-health",
      "type": "table",
      "title": "证据与数据健康",
      "rowsPath": "dailyCockpit.sources",
      "columns": [
        { "key": "label", "label": "入口", "format": "text" },
        { "key": "detail", "label": "状态说明", "format": "text" },
        { "key": "asOf", "label": "截至时间", "format": "text" },
        { "key": "status", "label": "健康状态", "format": "text" }
      ],
      "emptyText": "数据健康入口不可用"
    },
    {
      "id": "review-events",
      "type": "table",
      "title": "复核与反转信号",
      "rowsPath": "dailyCockpit.alerts",
      "columns": [
        { "key": "fundCode", "label": "基金", "format": "text" },
        { "key": "title", "label": "事件", "format": "text" },
        { "key": "detail", "label": "说明", "format": "text" },
        { "key": "severity", "label": "严重度", "format": "text" }
      ],
      "emptyText": "没有返回未决复核事件"
    },
    {
      "id": "professional-workflow",
      "type": "table",
      "title": "九段式专业研究内核",
      "rowsPath": "methodology.stages",
      "columns": [
        { "key": "order", "label": "阶段", "format": "number" },
        { "key": "name", "label": "名称", "format": "text" },
        { "key": "hardGates", "label": "硬门槛", "format": "text" }
      ],
      "emptyText": "方法阶段不可用"
    },
    {
      "id": "research-actions",
      "type": "actions",
      "items": [
        { "id": "fund-universe", "label": "查询研究范围", "capability": "fund.universe.query" },
        { "id": "fund-evidence", "label": "读取证据快照", "capability": "fund.evidence.snapshot" },
        { "id": "fund-explain", "label": "解释研究状态", "capability": "fund.research.explain" }
      ]
    }
  ]
}
