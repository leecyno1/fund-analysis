{
  "schemaVersion": "1.0",
  "id": "professional-fund-research-suite",
  "name": "基金选择助手",
  "description": "帮助普通用户找基金、看调研、做现场分析、查看业绩归因并获得同类候选基金。",
  "version": "0.4.0",
  "publisher": "leecyno1",
  "upstream": "https://github.com/leecyno1/fund-analysis",
  "tags": ["基金浏览", "基金评价", "基金分类", "业绩归因", "基金推荐"],
  "agentWorkspace": { "type": "desk" },
  "runtime": {
    "type": "external",
    "baseUrlEnv": "NEWMA_DESK_FUND_RESEARCH_WEB_URL",
    "defaultBaseUrl": "http://127.0.0.1:3000"
  },
  "manifest": {
    "schemaVersion": "1.1",
    "category": "research",
    "navigation": {
      "groupLabel": "基金选择助手",
      "groupOrder": 20,
      "itemOrder": 100,
      "project": {
        "id": "professional-fund-research",
        "name": "基金选择助手",
        "order": 22,
        "description": "从真实基金数据、调研纪要和量化归因出发，完成基金浏览、评价和候选筛选。"
      },
      "icon": "research"
    },
    "compatibility": {
      "level": 3,
      "bridgeProtocol": "1.0",
      "sdkVersion": "fund-research-adapter-0.2.0",
      "viewSpecVersion": "1.0"
    },
    "permissions": ["research.read", "research.local-write"],
    "dataServices": ["fund-research-data"],
    "storage": {
      "mode": "dedicated",
      "adapter": "fund-research-postgres"
    },
    "actions": {
      "fund.search": {
        "binding": { "type": "data", "service": "fund-research-data", "capability": "fund.search" },
        "execution": "request",
        "permission": "research.read",
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": { "type": "string", "maxLength": 80 },
            "page": { "type": "integer", "minimum": 1 },
            "page_size": { "type": "integer", "minimum": 1, "maximum": 100 }
          },
          "additionalProperties": false
        },
        "outputSchema": { "type": "object", "additionalProperties": true },
        "confirmation": "none",
        "timeoutSeconds": 30
      },
      "fund.research.snapshot": {
        "binding": { "type": "data", "service": "fund-research-data", "capability": "fund.research.snapshot" },
        "execution": "request",
        "permission": "research.read",
        "inputSchema": {
          "type": "object",
          "required": ["symbol"],
          "properties": { "symbol": { "type": "string", "maxLength": 24 } },
          "additionalProperties": false
        },
        "outputSchema": { "type": "object", "additionalProperties": true },
        "confirmation": "none",
        "timeoutSeconds": 60
      },
      "fund.compare": {
        "binding": { "type": "data", "service": "fund-research-data", "capability": "fund.compare" },
        "execution": "request",
        "permission": "research.read",
        "inputSchema": {
          "type": "object",
          "required": ["windCodes"],
          "properties": {
            "windCodes": {
              "type": "array",
              "items": { "type": "string", "maxLength": 24 },
              "minItems": 2,
              "maxItems": 12
            },
            "window": { "enum": ["1y", "3y", "5y"] }
          },
          "additionalProperties": false
        },
        "outputSchema": { "type": "object", "additionalProperties": true },
        "confirmation": "none",
        "timeoutSeconds": 60
      },
      "fund.attribution.run": {
        "binding": { "type": "data", "service": "fund-research-data", "capability": "fund.attribution.run" },
        "execution": "request",
        "permission": "research.read",
        "inputSchema": {
          "type": "object",
          "required": ["symbol"],
          "properties": {
            "symbol": { "type": "string", "maxLength": 24 },
            "quarter": { "type": "string", "maxLength": 8 }
          },
          "additionalProperties": false
        },
        "outputSchema": { "type": "object", "additionalProperties": true },
        "confirmation": "none",
        "timeoutSeconds": 120
      },
      "fund.analysis.run": {
        "binding": { "type": "data", "service": "fund-research-data", "capability": "fund.analysis.run" },
        "execution": "request",
        "permission": "research.local-write",
        "inputSchema": {
          "type": "object",
          "required": ["windCode"],
          "properties": {
            "windCode": { "type": "string", "maxLength": 24 },
            "question": { "type": "string", "maxLength": 1000 }
          },
          "additionalProperties": false
        },
        "outputSchema": { "type": "object", "additionalProperties": true },
        "confirmation": "user",
        "timeoutSeconds": 180
      },
      "fund.recommendations.list": {
        "binding": { "type": "data", "service": "fund-research-data", "capability": "fund.recommendations.list" },
        "execution": "request",
        "permission": "research.read",
        "inputSchema": {
          "type": "object",
          "required": ["category"],
          "properties": {
            "category": { "type": "string", "maxLength": 120 },
            "style": { "type": "string", "maxLength": 80 }
          },
          "additionalProperties": false
        },
        "outputSchema": { "type": "object", "additionalProperties": true },
        "confirmation": "none",
        "timeoutSeconds": 120
      }
    },
    "events": {
      "emits": ["security.selected"],
      "accepts": ["security.selected"]
    },
    "refresh": { "mode": "manual" }
  },
  "pages": [
    {
      "id": "fund-discover",
      "name": "找基金",
      "description": "搜索基金，查看净值、指标、基金详情并进入多基金比较。",
      "tags": ["基金浏览", "净值", "比较"],
      "route": "/mod/fund-research/discover",
      "navigation": { "itemOrder": 10, "label": "找基金" },
      "defaultInstall": true
    },
    {
      "id": "fund-research-library",
      "name": "调研库",
      "description": "连接本地调研纪要，按基金经理归类并确认基金分类和风格标签。",
      "tags": ["调研纪要", "基金经理", "风格标签"],
      "route": "/mod/fund-research/research",
      "navigation": { "itemOrder": 20, "label": "调研库" },
      "defaultInstall": true
    },
    {
      "id": "fund-ai-analysis",
      "name": "AI 分析",
      "description": "按需运行基金评价，使用研究快照和业绩归因证据并保存分析历史。",
      "tags": ["基金评价", "AI 分析", "历史记录"],
      "route": "/mod/fund-research/analysis",
      "navigation": { "itemOrder": 30, "label": "AI 分析" },
      "defaultInstall": true
    },
    {
      "id": "fund-recommendations",
      "name": "标签推荐",
      "description": "按基金类别和风格标签返回不超过十只真实候选基金。",
      "tags": ["基金推荐", "同类评价", "风格标签"],
      "route": "/mod/fund-research/recommendations",
      "navigation": { "itemOrder": 40, "label": "标签推荐" },
      "defaultInstall": true
    },
    {
      "id": "fund-attribution",
      "name": "业绩归因",
      "description": "查看 Barra 风格与风险暴露、Brinson 配置与选择效应及证据覆盖。",
      "tags": ["Barra", "Brinson", "业绩归因"],
      "route": "/mod/fund-research/advanced",
      "navigation": { "itemOrder": 50, "label": "业绩归因" },
      "defaultInstall": true
    }
  ]
}
