{
  "id": "fund-research-data",
  "name": "基金选择数据服务",
  "description": "复用基金选择应用的真实基金浏览、研究快照、比较、归因、现场分析和推荐入口。",
  "priority": 20,
  "baseUrl": "http://127.0.0.1:3000/api",
  "healthPath": "/newma-desk/health",
  "transport": "rest",
  "capabilities": {
    "fund.search": { "method": "GET", "path": "/fund-browser", "permission": "research.read" },
    "fund.research.snapshot": { "method": "GET", "path": "/funds/{symbol}/research-snapshot", "permission": "research.read" },
    "fund.compare": { "method": "POST", "path": "/funds/research-compare", "permission": "research.read" },
    "fund.attribution.run": { "method": "GET", "path": "/attribution/fund/{symbol}", "permission": "research.read" },
    "fund.analysis.run": { "method": "POST", "path": "/analysis/evaluate", "permission": "research.local-write" },
    "fund.recommendations.list": { "method": "GET", "path": "/recommendations", "permission": "research.read" }
  },
  "timeoutSeconds": 180,
  "allowedHosts": ["127.0.0.1", "localhost"]
}
